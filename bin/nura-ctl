# nura-ctl — управление экраном оболочки удалённо (нужен root):
#   nura-ctl top       = VOL+ и VOL- вместе (табло <-> htop)
#   nura-ctl console   = VOL- дважды        (консоль)
#   nura-ctl menu      = VOL+ дважды        (меню)
#   nura-ctl lock      = короткое нажатие питания (погасить экран и заблокировать)
#   nura-ctl unlock    = снять блокировку без пароля (администратор по SSH)
rt() { python3 -c "import signal; print(int(signal.SIGRTMIN) + $1)"; }
case "${1:-}" in
  top) sig=USR1 ;;
  console) sig=USR2 ;;
  menu) sig=HUP ;;
  lock) sig=$(rt 1) ;;
  unlock) sig=$(rt 2) ;;
  *) sed -n '4,9p' "$0"; exit 2 ;;
esac
if [ -d /run/systemd/system ]; then
  exec systemctl kill --kill-whom=main -s "$sig" nura-keys
fi
pid=$(pgrep -o -f "python3 -I /usr/local/bin/nura-keys")
[ -n "$pid" ] || { echo "nura-keys не запущен" >&2; exit 1; }
exec kill -s "$sig" "$pid" 2>/dev/null || exec kill -"$sig" "$pid"
