[ -n "$ids" ] && { echo "Перезапуск: $(echo $ids | wc -w) шт."; docker restart -t 20 $ids >/dev/null; }
for c in $(docker ps -aq --filter status=exited --filter status=created); do
  case $(docker inspect -f '{{.HostConfig.RestartPolicy.Name}}' $c) in
    always|unless-stopped|on-failure) echo "Запуск: $(docker inspect -f '{{.Name}}' $c)"; docker start $c >/dev/null;;
  esac
done
sleep 2
docker ps -a --format '{{.Names}}|{{.State}}' | sed 's/|/  /'
"""
