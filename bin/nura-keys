con=$(nmcli -g GENERAL.CONNECTION device show wlan0)
if [ -n "$con" ]; then
  echo "Переподключение: $con"; nmcli -w 40 connection up "$con" >/dev/null 2>&1
else
  echo "Подключение wlan0"; nmcli -w 40 device connect wlan0 >/dev/null 2>&1
fi
rc=$?
sleep 3
iw dev wlan0 link | sed -n 's/^[[:space:]]*\(SSID\|signal\): /\1 /p'
echo "IP $(ip -4 -o addr show wlan0 | awk '{print $4}')"
gw=$(ip -4 route show default dev wlan0 | awk '{print $3; exit}')
if [ -n "$gw" ] && ping -c2 -W2 "$gw" >/dev/null; then echo "Шлюз $gw OK"; else echo "Шлюз не отвечает"; rc=1; fi
exit $rc
"""
WIFI_ITEM = "wifi"       # особый пункт: свой экран со списком сетей
ROT_ITEM = "rotate"      # особый пункт: портрет/альбом для htop и консоли
MENU_ITEMS = [
    ("Подключить к Wi-Fi", WIFI_ITEM, None),
    ("Ориентация htop/консоли", ROT_ITEM, None),
    ("Перезапустить контейнеры", "Перезапустить контейнеры?", CMD_CONTAINERS),
