    ("Выключить", "Выключить телефон?", "echo 'Выключение...'; poweroff"),
    ("Назад", None, None),
]


def log(msg):
    print(msg, flush=True)


def run(*cmd):
    subprocess.run(cmd, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _caps(event, kind):
    """Битовая маска возможностей устройства (capabilities/key, abs) как int."""
    try:
        with open(f"/sys/class/input/{event}/device/capabilities/{kind}") as f:
            words = f.read().split()
    except OSError:
        return 0
    # Слова — старшие первыми, размером с long ядра: 64 бита на aarch64,
    # 32 бита на armv7 (bacon, Nexus 5). Разрядность python = разрядность ядра.
    bits = struct.calcsize("l") * 8
    mask = 0
    for w in words:
        mask = (mask << bits) | int(w, 16)
    return mask


def key_devices():
    """Все устройства с кнопками громкости (на sdm660 VOL+ и VOL- — на разных)."""
    devs = []
    for path in sorted(glob.glob("/sys/class/input/event*")):
        ev = os.path.basename(path)
        keys = _caps(ev, "key")
        if keys >> KEY_VOLUMEUP & 1 or keys >> KEY_VOLUMEDOWN & 1:
            devs.append("/dev/input/" + ev)
    return devs


def power_devices():
    """Устройства с кнопкой питания (KEY_POWER): короткое нажатие — блокировка."""
    devs = []
    for path in sorted(glob.glob("/sys/class/input/event*")):
        ev = os.path.basename(path)
        if _caps(ev, "key") >> KEY_POWER & 1:
            devs.append("/dev/input/" + ev)
    return devs


def touch_device():
    """Первое устройство с мультитач-координатами (Synaptics, Novatek, ...)."""
    for path in sorted(glob.glob("/sys/class/input/event*")):
        ev = os.path.basename(path)
        if _caps(ev, "abs") >> ABS_MT_POSITION_X & 1:
            return "/dev/input/" + ev
    return None


def find_device(name, prefix=False):
    """Устройство ввода по имени; prefix=True — по началу имени."""
    for path in sorted(glob.glob("/sys/class/input/event*/device/name")):
        with open(path) as f:
            n = f.read().strip()
        if n == name or (prefix and n.startswith(name)):
            return "/dev/input/" + path.split("/")[4]
    return None


def read_int(path):
    with open(path) as f:
        return int(f.read())


def bright_step(direction):
    cur = read_int(BL + "/brightness")
    top = read_int(BL + "/max_brightness")         # 255 (msm8974), 4095 (sdm660)
    levels = sorted({max(1, round(p * top / 100)) for p in LEVELS_PCT})
    if direction > 0:
        new = next((v for v in levels if v > cur), levels[-1])
    else:
        new = next((v for v in reversed(levels) if v < cur), levels[0])
    with open(BL + "/brightness", "w") as f:
        f.write(str(new))


def chvt(n):
    # Ограничение времени: при запрете переключения (VT_LOCKSWITCH) chvt ждёт вечно.
    try:
        subprocess.run(["chvt", str(n)], check=False, timeout=3,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        log(f"chvt {n}: timeout (switching locked?)")


def read_conf():
    """/etc/nura-server-shell.conf: KEY=VALUE (LOCK=0 — без блокировки, LOCK_USER=...)."""
    conf = {"LOCK": "1", "LOCK_USER": ""}
    try:
        with open(CONF_FILE) as f:
            for ln in f:
                ln = ln.strip()
                if ln and not ln.startswith("#") and "=" in ln:
                    key, val = ln.split("=", 1)
                    conf[key.strip()] = val.strip().strip('"')
    except OSError:
        pass
    return conf


def main_user():
    """Основной пользователь: первый с UID 10000..59999 (как в postmarketOS)."""
    try:
        with open("/etc/passwd") as f:
            for ln in f:
                p = ln.split(":")
                if len(p) > 2 and p[2].isdigit() and 10000 <= int(p[2]) < 60000:
                    return p[0]
    except OSError:
        pass
    return "root"


def check_password(user, password):
    """Проверка системного пароля через unix_chkpwd (Linux-PAM), как у блокировщиков экрана."""
    for helper in ("/usr/sbin/unix_chkpwd", "/sbin/unix_chkpwd"):
        if os.path.exists(helper):
            break
    else:
        log("lock: unix_chkpwd not found")
        return False
    try:
        r = subprocess.run([helper, user, "nonull"], input=password + b"\0",
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)
        return r.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def vt_lockswitch(on):
    """Запрет переключения консолей (Alt+Fn, chvt) — на время блокировки."""
    try:
        fd = os.open("/dev/tty0", os.O_RDWR | os.O_NOCTTY)
        try:
            fcntl.ioctl(fd, VT_LOCKSWITCH if on else VT_UNLOCKSWITCH)
        finally:
            os.close(fd)
    except OSError as e:
        log(f"lock: VT_{'LOCK' if on else 'UNLOCK'}SWITCH failed: {e}")


def _tioclinux(cmd):
    try:
        fd = os.open("/dev/tty0", os.O_RDWR | os.O_NOCTTY)
        try:
            fcntl.ioctl(fd, TIOCLINUX, bytes([cmd]))
        finally:
            os.close(fd)
    except OSError:
        pass


def screen_blank():
    """Погасить экран. Внимание: после TIOCL_BLANKSCREEN ядро НЕ включает экран
    по нажатию клавиш — включаем сами (screen_unblank) на любое нажатие или касание."""
    _tioclinux(TIOCL_BLANKSCREEN)


def screen_unblank():
    _tioclinux(TIOCL_UNBLANKSCREEN)


def screen_blanked():
    try:
        with open(FB_BLANK) as f:
            return f.read().strip() not in ("", "0")
    except OSError:
        return False


class Lock:
    """Экран блокировки на tty7: пароль пользователя с экранной клавиатуры.

    Ввод читается прямо с tty7 (raw), пароль проверяет unix_chkpwd. Пока экран
    заблокирован, переключение консолей запрещено (VT_LOCKSWITCH).
    """
    tty_path = f"/dev/tty{LOCK_VT}"
    STATES = {"ok": ("в порядке", "1;32"), "warn": ("предупреждение", "1;33"),
              "bad": ("проблема", "1;31")}

    def __init__(self, user):
        self.user = user
        self.out = None
        self.kbd = None
        self.buf = bytearray()
        self.msg = ""
        self.esc = 0
        self.drawn = 0.0

    def start(self):
        run("setfont", "-C", self.tty_path, "-d", FONT)
        self.out = os.open(self.tty_path, os.O_RDWR | os.O_NOCTTY)
        tty.setraw(self.out)
        termios.tcflush(self.out, termios.TCIFLUSH)
        self.buf.clear()
        self.msg, self.esc = "", 0
        vt_lockswitch(False)             # снять запрет от аварийно завершённого процесса
        chvt(LOCK_VT)
        vt_lockswitch(True)
        run("pkill", "-x", "buffyboard")
        os.write(self.out, b"\x1b[0m\x1b[2J")   # полная очистка — только до запуска клавиатуры
        self.draw()
        # как в консоли: buffyboard уменьшает высоту только «занятого» и уже активного
        # терминала — даём переключению завершиться, иначе tty7 остаётся во весь экран
        # и перерисовка текста затирает клавиатуру
        time.sleep(1.0)
        self.kbd = subprocess.Popen(buffyboard_cmd(0), stdin=subprocess.DEVNULL,
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        log("locked")

    def stop(self):
        vt_lockswitch(False)
        if self.kbd:
            self.kbd.terminate()
            try:
                self.kbd.wait(2)
            except subprocess.TimeoutExpired:
                self.kbd.kill()
                self.kbd.wait()
            self.kbd = None
        if self.out is not None:
            os.write(self.out, b"\x1b[0m\x1b[2J\x1b[H")
            os.close(self.out)
            self.out = None
        self.buf = bytearray()

    def keyboard_alive(self):
        return self.kbd is not None and self.kbd.poll() is None

    def restart_keyboard(self, kill=False):
        if kill and self.kbd and self.kbd.poll() is None:
            self.kbd.terminate()
            try:
                self.kbd.wait(2)
            except subprocess.TimeoutExpired:
                self.kbd.kill()
                self.kbd.wait()
        self.kbd = subprocess.Popen(buffyboard_cmd(0), stdin=subprocess.DEVNULL,
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # --- счётчик ошибок (на диске: перезапуск службы его не сбрасывает) ---
    @staticmethod
    def fails():
        try:
            with open(FAILS_FILE) as f:
                n, t = f.read().split()
                return int(n), float(t)
        except (OSError, ValueError):
            return 0, 0.0

    @staticmethod
    def save_fails(n):
        os.makedirs(os.path.dirname(FAILS_FILE), exist_ok=True)
        with open(FAILS_FILE, "w") as f:
            f.write(f"{n} {time.time()}\n")

    def lockout_left(self):
        n, t = self.fails()
        if n >= LOCK_FAILS_MAX:
            left = LOCK_LOCKOUT - (time.time() - t)
            if left > 0:
                return int(left) + 1
        return 0

    # --- экран ---
    def w(self, s):
        os.write(self.out, s.encode())

    def at(self, row, text, style="0"):
        self.w(f"\x1b[{row + 1};1H\x1b[{style}m{text[:33]}\x1b[K\x1b[0m")

    def draw(self):
        if self.out is None:
            return
        try:
            with open(STATE_FILE) as f:
                state = f.read().strip()
        except OSError:
            state = ""
        label, style = self.STATES.get(state, ("—", "37"))
        # без ESC[2J: стираем только строки текста, область клавиатуры не трогаем
        self.w("\x1b[?25l\x1b[0m")
        for row in (2, 5, 7, 10):
            self.at(row, "")
        self.at(0, " " + os.uname().nodename, "1;33")
        self.at(1, " " + time.strftime("%d.%m %H:%M"), "37")
        self.at(3, " Состояние:", "37")
        self.at(4, " " + label, style)
        self.at(6, " ЗАБЛОКИРОВАНО", "1;37")
        left = self.lockout_left()
        if left:
            self.at(8, f" Много ошибок. Ждите {left} с", "1;31")
            self.at(9, "")
        else:
            self.at(8, " Пароль и Enter:", "37")
            self.prompt()
        self.at(11, (" " + self.msg) if self.msg else "", "1;31")
        self.drawn = time.monotonic()

    def prompt(self):
        self.at(9, " " + "*" * min(len(self.buf), 30) + "_", "1;37")

    # --- ввод ---
    def feed(self, data):
        """Байты с клавиатуры. True — пароль верный, можно разблокировать."""
        if self.lockout_left():
            self.buf.clear()
            self.draw()
            return False
        for b in data:
            if self.esc:                 # пропуск ESC-последовательностей (стрелки и т. п.)
                if self.esc == 1:
                    self.esc = 2 if b in (0x5b, 0x4f) else 0
                elif 0x40 <= b <= 0x7e:
                    self.esc = 0
                continue
            if b == 0x1b:
                self.esc = 1
            elif b in (0x0d, 0x0a):
                return self.submit()
            elif b in (0x7f, 0x08):
                if self.buf:
                    self.buf.pop()
            elif b == 0x15:              # Ctrl+U — стереть всё
                self.buf.clear()
            elif b >= 0x20 and len(self.buf) < 256:
                self.buf.append(b)
        self.prompt()
        return False

    def submit(self):
        password = bytes(self.buf)
        self.buf.clear()
        if not password:
            self.prompt()
            return False
        self.at(9, " Проверка...", "37")
        if check_password(self.user, password):
            self.save_fails(0)
            log(f"unlocked by password of {self.user}")
            return True
        n = self.fails()[0] + 1
        self.save_fails(n)
        log(f"lock: wrong password ({n} in a row)")
        self.msg = "Неверный пароль"
        time.sleep(LOCK_DELAY)
        termios.tcflush(self.out, termios.TCIFLUSH)   # набранное во время паузы — в сторону
        self.draw()
        return False

    def tick(self):
        if self.out is not None and time.monotonic() - self.drawn >= 30 and not self.buf:
            self.draw()                  # часы и оставшаяся пауза


def get_rotation():
    try:
        with open(ROT_FILE) as f:
            rot = 1 if f.read().strip() == "1" else 0
    except OSError:
        return 0
    return rot if rot == 0 or rotation_supported() else 0


def set_rotation(rot):
    os.makedirs(os.path.dirname(ROT_FILE), exist_ok=True)
    with open(ROT_FILE, "w") as f:
        f.write(f"{rot}\n")


def fbcon_rotate(rot):
    """Повернуть текущую (активную) консоль: 0 — портрет, 1 — на 90° по часовой."""
    try:
        with open("/sys/class/graphics/fbcon/rotate", "w") as f:
            f.write(str(rot))
    except OSError:
        pass


def rotation_supported():
    """Умеет ли ядро поворачивать консоль (CONFIG_FRAMEBUFFER_CONSOLE_ROTATION)."""
    import gzip
    for path, opener in (("/proc/config.gz", gzip.open), ("/boot/config", open)):
        try:
            with opener(path, "rt") as f:
                return any(ln.strip() == "CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y" for ln in f)
        except OSError:
            continue
    return False


def buffyboard_cmd(rot):
    return ["buffyboard", f"--rotate={rot}"]


def to_logical(x, y, rot):
    """Координаты касания (портрет) -> координаты на повёрнутой консоли."""
    if rot == 1:                 # по часовой: верх консоли — правый край телефона
        return y, SCREEN_W - 1 - x
    return x, y


class Top:
    """htop в псевдотерминале, выведенный на tty2.

    Ввод с клавиатуры (экранная buffyboard или USB OTG) приходит на tty2
    (он в raw-режиме) и передаётся в htop. Размер tty2 меняется, когда
    buffyboard показана, — новый размер переносится на псевдотерминал.
    """
    tty_path = f"/dev/tty{TOP_VT}"

    def __init__(self):
        self.pid = self.master = self.out = None
        self.kbd = None
        self.winsz = None

    def running(self):
        return self.pid is not None

    def start(self):
        self.rot = get_rotation()
        # портрет — мелкий шрифт (90 колонок, видна вся строка F1..F10), альбом — обычный (120)
        run("setfont", "-C", self.tty_path, FONT if self.rot else TOP_FONT_PORTRAIT)
        chvt(TOP_VT)
        fbcon_rotate(self.rot)
        self.out = os.open(self.tty_path, os.O_RDWR | os.O_NOCTTY)
        tty.setraw(self.out)
        os.write(self.out, b"\x1b[?25l\x1b[2J\x1b[H")
        winsz = fcntl.ioctl(self.out, termios.TIOCGWINSZ, b"\0" * 8)
        rows, cols = struct.unpack("HHHH", winsz)[:2]
        # размер символа — по полному размеру терминала (до появления клавиатуры)
        lw, lh = (SCREEN_H, SCREEN_W) if self.rot else (SCREEN_W, SCREEN_H)
        self.cell = (lw // max(cols, 1), lh // max(rows, 1))
        pid, master = pty.fork()
        if pid == 0:
            os.execvpe(HTOP_CMD[0], HTOP_CMD, dict(ENV, TERM="linux"))
        fcntl.ioctl(master, termios.TIOCSWINSZ, winsz)
        os.kill(pid, signal.SIGWINCH)
        self.pid, self.master, self.winsz = pid, master, winsz
        log(f"htop started pid={pid} size={cols}x{rows}")

    # --- экранная клавиатура ---
    def keyboard_on(self):
        return self.kbd is not None and self.kbd.poll() is None

    def toggle_keyboard(self):
        if self.keyboard_on():
            self.hide_keyboard()
        else:
            run("pkill", "-x", "buffyboard")
            self.kbd = subprocess.Popen(buffyboard_cmd(self.rot), stdin=subprocess.DEVNULL,
                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            log(f"htop keyboard on, buffyboard pid={self.kbd.pid}")

    def tap(self, x, y):
        """Касание строки функций htop (последняя строка) -> F1..F10."""
        if self.winsz is None:
            return
        rows, cols = struct.unpack("HHHH", self.winsz)[:2]
        lx, ly = to_logical(x, y, self.rot)
        cw, ch = self.cell
        if ly // ch != rows - 1:
            return
        n = min(lx // cw // 8, 9)    # пункты по 8 колонок: «F1Help  », ..., «F10Quit»
        self.send(FKEYS[n])
        log(f"htop tap -> F{n + 1}")

    def hide_keyboard(self):
        if self.kbd:
            self.kbd.terminate()
            try:
                self.kbd.wait(2)
            except subprocess.TimeoutExpired:
                self.kbd.kill()
                self.kbd.wait()
            self.kbd = None
            log("htop keyboard off")

    def sync_size(self):
        """Перенести размер tty2 (меняется buffyboard) на псевдотерминал htop."""
        if self.out is None or self.master is None:
            return
        try:
            winsz = fcntl.ioctl(self.out, termios.TIOCGWINSZ, b"\0" * 8)
        except OSError:
            return
        if winsz != self.winsz:
            self.winsz = winsz
            fcntl.ioctl(self.master, termios.TIOCSWINSZ, winsz)
            try:
                os.kill(self.pid, signal.SIGWINCH)
            except ProcessLookupError:
                pass
            rows, cols = struct.unpack("HHHH", winsz)[:2]
            log(f"htop resized to {cols}x{rows}")

    def forward_input(self):
        """Ввод с клавиатуры на tty2 -> htop."""
        try:
            data = os.read(self.out, 4096)
        except OSError:
            return
        if data:
            self.send(data)

    def stop(self):
        self.hide_keyboard()
        if self.pid:
            try:
                os.kill(self.pid, signal.SIGTERM)
                for _ in range(20):
                    if os.waitpid(self.pid, os.WNOHANG)[0]:
                        break
                    time.sleep(0.05)
                else:
                    os.kill(self.pid, signal.SIGKILL)
                    os.waitpid(self.pid, 0)
            except (ProcessLookupError, ChildProcessError):
                pass
            log("htop stopped")
        for fd in (self.master, self.out):
            if fd is not None:
                try:
                    os.close(fd)
                except OSError:
                    pass
        self.pid = self.master = self.out = self.winsz = None

    def pump(self):
        try:
            data = os.read(self.master, 65536)
        except OSError as e:
            if e.errno == errno.EIO:
                return False
            raise
        if not data:
            return False
        os.write(self.out, data)
        return True

    def send(self, data):
        if self.master is not None:
            os.write(self.master, data)


class Console:
    """Вход в систему на tty3 + экранная клавиатура buffyboard."""
    tty_path = f"/dev/tty{CONSOLE_VT}"
    getty = f"getty@tty{CONSOLE_VT}.service"

    def __init__(self):
        self.kbd = None
        self.getty_proc = None   # OpenRC: getty запускаем сами (в inittab tty3 отключён)
        self.started = 0.0

    def getty_start(self):
        if SYSTEMD:
            run("systemctl", "start", self.getty)
        else:
            self.getty_proc = subprocess.Popen(
                ["setsid", "getty", "38400", f"tty{CONSOLE_VT}"],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def getty_stop(self):
        if SYSTEMD:
            run("systemctl", "stop", self.getty)
        else:
            run("pkill", "-f", f"getty 38400 tty{CONSOLE_VT}$")
            if self.getty_proc:
                try:
                    self.getty_proc.wait(2)
                except subprocess.TimeoutExpired:
                    pass
                self.getty_proc = None

    def start(self):
        run("pkill", "-x", "buffyboard")     # две копии сразу шлют лишние нажатия
        run("setfont", "-C", self.tty_path, FONT)
        chvt(CONSOLE_VT)
        self.rot = get_rotation()
        fbcon_rotate(self.rot)           # до getty: иначе приглашение печатается дважды
        try:                             # busybox getty не очищает экран (agetty очищает)
            fd = os.open(self.tty_path, os.O_WRONLY | os.O_NOCTTY)
            os.write(fd, b"\x1b[H\x1b[2J\x1b[3J")
            os.close(fd)
        except OSError:
            pass
        self.getty_start()
        # buffyboard уменьшает высоту только «занятого» терминала (ignore_unused_terminals),
        # и getty при старте очищает экран — поэтому сначала даём getty открыть tty3
        time.sleep(1.5)
        self.kbd = subprocess.Popen(buffyboard_cmd(self.rot), stdin=subprocess.DEVNULL,
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.started = time.time()
        log(f"console started, buffyboard pid={self.kbd.pid}")

    def sessions(self):
        try:
            out = subprocess.run(["loginctl", "list-sessions", "--json=short"],
                                 capture_output=True, text=True, check=False).stdout
            return [s["session"] for s in json.loads(out or "[]")
                    if s.get("tty") == f"tty{CONSOLE_VT}"]
        except (ValueError, KeyError):
            return []

    def stop(self):
        if self.kbd:
            self.kbd.terminate()
            try:
                self.kbd.wait(2)
            except subprocess.TimeoutExpired:
                self.kbd.kill()
                self.kbd.wait()
            self.kbd = None
        for sid in self.sessions():
            run("loginctl", "terminate-session", sid)
            log(f"session {sid} on tty{CONSOLE_VT} terminated")
        self.getty_stop()
        log("console stopped")

    def last_activity(self):
        t = self.started
        try:
            t = max(t, os.stat(self.tty_path).st_atime)
        except OSError:
            pass
        return t


def nm_split(line):
    """Разбор строки `nmcli -t`: поля через ':', двоеточие в значении экранировано '\\:'."""
    out, cur, esc = [], "", False
    for ch in line:
        if esc:
            cur += ch
            esc = False
        elif ch == "\\":
            esc = True
        elif ch == ":":
            out.append(cur)
            cur = ""
        else:
            cur += ch
    out.append(cur)
    return out


def wifi_scan():
    """Список сетей: [{ssid, signal, secure, active, known}], сильные первыми."""
    def nm(*args, timeout=25):
        try:
            return subprocess.run(["nmcli", *args], capture_output=True, text=True,
                                  timeout=timeout, env=ENV).stdout
        except subprocess.TimeoutExpired:
            return ""
    known = set()
    for ln in nm("-t", "-f", "NAME,TYPE", "connection", "show").splitlines():
        f = nm_split(ln)
        if len(f) >= 2 and f[1] == "802-11-wireless":
            known.add(f[0])
    nets = {}
    out = nm("-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "device", "wifi", "list",
             "--rescan", "yes")
    for ln in out.splitlines():
        f = nm_split(ln)
        if len(f) < 4 or not f[1]:
            continue
        sig = int(f[2]) if f[2].isdigit() else 0
        n = nets.get(f[1])
        if n is None or sig > n["signal"]:
            nets[f[1]] = {"ssid": f[1], "signal": sig,
                          "secure": f[3] not in ("", "--"),
                          "active": f[0] == "*" or (n or {}).get("active", False),
                          "known": f[1] in known}
        elif f[0] == "*":
            n["active"] = True
    return sorted(nets.values(), key=lambda n: -n["signal"])[:WIFI_MAX]


class WifiJoin:
    """Ввод пароля новой сети на tty5 (nura-wifi-join + экранная клавиатура)."""
    tty_path = f"/dev/tty{WIFI_VT}"

    def __init__(self):
        self.ssid = None
        self.proc = None
        self.kbd = None
        self.started = 0.0

    def start(self):
        run("pkill", "-x", "buffyboard")
        run("setfont", "-C", self.tty_path, "-d", FONT)   # крупно, как меню: 33 колонки
        try:
            os.unlink(WIFI_LOG)
        except OSError:
            pass
        run("pkill", "-f", WIFI_JOIN)         # на случай зависшего прошлого запуска
        # своя сессия (start_new_session): при отмене завершаем всю группу, вместе с nmcli.
        # Не через утилиту setsid: лидер группы она форкает и сразу выходит с кодом 0.
        self.proc = subprocess.Popen(
            ["sh", "-c", f'exec {WIFI_JOIN} "$1" <>{self.tty_path} >&0 2>&0',
             "sh", self.ssid], env=ENV, start_new_session=True)
        chvt(WIFI_VT)
        time.sleep(1.5)                       # как у консоли: buffyboard после открытия tty
        self.kbd = subprocess.Popen(["buffyboard"], stdin=subprocess.DEVNULL,
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.started = time.time()
        log(f"wifi join started: {self.ssid!r}")

    def stop(self):
        if self.kbd:
            self.kbd.terminate()
            try:
                self.kbd.wait(2)
            except subprocess.TimeoutExpired:
                self.kbd.kill()
                self.kbd.wait()
            self.kbd = None
        if self.proc and self.proc.poll() is None:
            try:
                os.killpg(self.proc.pid, signal.SIGTERM)
            except OSError:
                pass
            try:
                self.proc.wait(3)
            except subprocess.TimeoutExpired:
                os.killpg(self.proc.pid, signal.SIGKILL)
                self.proc.wait()
        self.proc = None
        log("wifi join stopped")

    def finished(self):
        """Код выхода помощника или None, пока он работает."""
        return self.proc.poll() if self.proc else None

    def result(self):
        try:
            with open(WIFI_LOG) as f:
                return [ln.rstrip("\n") for ln in f if ln.strip()]
        except OSError:
            return ["Нет результата"]

    def last_activity(self):
        t = self.started
        try:
            t = max(t, os.stat(self.tty_path).st_atime)
        except OSError:
            pass
        return t


class Menu:
    """Меню действий на tty4: выбор кнопками громкости, выполнение касанием."""
    tty_path = f"/dev/tty{MENU_VT}"
    COLS, ROWS = 33, 30
    ROW_PX = SCREEN_H // 30      # уточняется в start() по реальному числу строк
    ITEM_TOP, ITEM_H, ITEM_GAP = 2, 2, 1       # 6 пунктов + запас, кнопка 128 px
    YES_ROWS, NO_ROWS = range(8, 14), range(16, 22)

    def __init__(self):
        self.out = None
        self.screen = "list"     # list | confirm | nets | run | result
        self.title = ""
        self.nets = []
        self.sel = 0
        self.confirm_yes = False
        self.item = None
        self.proc = None
        self.lines = []
        self.rc = None
        self._buf = b""

    # --- служебное ---
    def start(self):
        run("setfont", "-C", self.tty_path, "-d", FONT)
        self.out = os.open(self.tty_path, os.O_WRONLY | os.O_NOCTTY)
        try:   # 30 строк на 1920 px, 36 — на 2340 px
            rows, cols = struct.unpack("HHHH", fcntl.ioctl(self.out, termios.TIOCGWINSZ, b"\0" * 8))[:2]
            self.ROWS, self.COLS, self.ROW_PX = rows, cols, SCREEN_H // max(rows, 1)
        except OSError:
            pass
        self.screen, self.sel = "list", 0
        chvt(MENU_VT)
        self.draw()
        log("menu started")

    def stop(self):
        if self.out is not None:
            os.close(self.out)
            self.out = None
        log("menu stopped")

    def busy(self):
        return self.proc is not None

    def w(self, s):
        os.write(self.out, s.encode())

    def at(self, row, text, style="0"):
        text = text[:self.COLS]
        self.w(f"\x1b[{row + 1};1H\x1b[{style}m{text}\x1b[K\x1b[0m")

    def block(self, rows, label, style):
        mid = rows[len(rows) // 2]
        for r in rows:
            txt = label.center(self.COLS) if r == mid else ""
            self.w(f"\x1b[{r + 1};1H\x1b[{style}m{txt.ljust(self.COLS)}\x1b[0m")

    def item_rows(self, i):
        top = self.ITEM_TOP + i * (self.ITEM_H + self.ITEM_GAP)
        return range(top, top + self.ITEM_H)

    def entries(self):
        """Число пунктов на текущем экране (для выбора кнопками)."""
        return len(self.nets) + 1 if self.screen == "nets" else len(MENU_ITEMS)

    @staticmethod
    def net_label(n):
        bars = "#" * (1 + n["signal"] // 25)
        mark = " *" if n["active"] else (" +" if n["known"] else "")
        lock = "" if n["secure"] else " open"
        return f"{n['ssid'][:17]} {bars:<4}{lock}{mark}"

    def show_result(self, title, lines, rc):
        self.title, self.lines, self.rc, self.screen = title, lines, rc, "result"
        self.draw()

    def wifi_list(self):
        self.title, self.screen = "Wi-Fi: поиск сетей", "run"
        self.lines = ["Сканирование...", "", "Обычно 5-10 секунд"]
        self.draw()
        self.nets = wifi_scan()
        log(f"wifi scan: {len(self.nets)} networks")
        self.screen, self.sel = "nets", 0
        self.draw()

    # --- экраны ---
    def draw(self):
        self.w("\x1b[?25l\x1b[0m\x1b[2J")
        if self.screen == "list":
            self.at(0, " МЕНЮ", "1;33")
            for i, (label, _, _) in enumerate(MENU_ITEMS):
                style = "1;37;44" if i == self.sel else "30;47"
                self.block(self.item_rows(i), label, style)
            self.at(23, " VOL +/-: выбор", "1;37")
            self.at(24, " Касание пункта: выполнить", "1;37")
            self.at(25, " VOL+ дважды: выход", "1;37")
            self.at(26, f" Без действий {IDLE_MENU} с: выход", "37")
        elif self.screen == "nets":
            self.at(0, " Wi-Fi: выберите сеть", "1;33")
            if not self.nets:
                self.at(3, " Сети не найдены", "1;31")
            for i, n in enumerate(self.nets):
                style = "1;37;44" if i == self.sel else "30;47"
                self.block(self.item_rows(i), self.net_label(n), style)
            back = len(self.nets)
            self.block(self.item_rows(back), "Назад",
                       "1;37;44" if self.sel == back else "30;47")
            self.at(23, " # сигнал * текущая + сохранена", "37")
            self.at(24, " VOL +/-: выбор", "1;37")
            self.at(25, " Касание сети: подключить", "1;37")
            self.at(26, " VOL+ дважды: выход", "1;37")
        elif self.screen == "confirm":
            self.at(0, " " + MENU_ITEMS[self.item][1], "1;33")
            self.at(2, " Коснитесь ДА или НЕТ", "1;37")
            yes_style = "1;37;41" if self.confirm_yes else "37;41"
            no_style = "1;37;42" if not self.confirm_yes else "37;42"
            self.block(self.YES_ROWS, ("> ДА <" if self.confirm_yes else "ДА"), yes_style)
            self.block(self.NO_ROWS, ("> НЕТ <" if not self.confirm_yes else "НЕТ"), no_style)
            self.at(24, " VOL +/-: выбор", "1;37")
        else:
            self.at(0, " " + self.title, "1;33")
            for n, line in enumerate(self.lines[-20:]):
                self.at(2 + n, " " + line)
            if self.screen == "run":
                self.at(24, " Выполняется...", "1;33")
            else:
                ok = self.rc == 0
                self.at(24, " Готово" if ok else f" Ошибка (код {self.rc})", "1;32" if ok else "1;31")
                self.at(26, " Касание: назад в меню", "1;37")

    # --- ввод ---
    def key(self, direction):
        if self.screen in ("list", "nets"):
            self.sel = (self.sel + direction) % self.entries()
        elif self.screen == "confirm":
            self.confirm_yes = not self.confirm_yes
        elif self.screen == "result":
            self.screen = "list"
        else:
            return
        self.draw()

    def touch(self, x, y):
        """'exit' — пункт «Назад»; ('wifi', ssid) — нужен ввод пароля."""
        row = y // self.ROW_PX
        if self.screen == "list":
            for i in range(len(MENU_ITEMS)):
                if row in self.item_rows(i):
                    self.sel = i
                    if MENU_ITEMS[i][1] == WIFI_ITEM:
                        self.wifi_list()
                        return None
                    if MENU_ITEMS[i][1] == ROT_ITEM:
                        if not rotation_supported():
                            self.show_result("Ориентация htop и консоли", [
                                "Ядро не умеет поворачивать",
                                "консоль: выключена опция",
                                "FRAMEBUFFER_CONSOLE_ROTATION.",
                                "", "Остаётся портретная."], 1)
                            return None
                        rot = 1 - get_rotation()
                        set_rotation(rot)
                        log(f"rotation -> {rot}")
                        self.show_result("Ориентация htop и консоли",
                                         ["Альбомная (120 колонок)" if rot else "Портретная (90/67 колонок)",
                                          "", "Применится при следующем", "открытии htop или консоли"], 0)
                        return None
                    if MENU_ITEMS[i][2] is None:
                        return "exit"
                    self.item, self.screen, self.confirm_yes = i, "confirm", False
                    self.draw()
                    return None
        elif self.screen == "nets":
            for i in range(len(self.nets) + 1):
                if row in self.item_rows(i):
                    self.sel = i
                    if i == len(self.nets):
                        self.screen, self.sel = "list", 0
                        self.draw()
                        return None
                    return self.wifi_pick(self.nets[i])
        elif self.screen == "confirm":
            if row in self.YES_ROWS:
                self.execute()
            elif row in self.NO_ROWS:
                self.screen = "list"
                self.draw()
        elif self.screen == "result":
            self.screen = "list"
            self.draw()
        return None

    def wifi_pick(self, n):
        ssid = n["ssid"]
        if n["active"]:
            self.show_result("Wi-Fi: " + ssid, ["Уже подключено"], 0)
            return None
        if n["known"] or not n["secure"]:
            # сохранённый профиль или открытая сеть — пароль не нужен
            q = ssid.replace("'", "'\\''")
            cmd = (f"nmcli -w 40 connection up id '{q}' >/dev/null 2>&1 || " if n["known"] else "") + \
                  f"nmcli -w 40 device wifi connect '{q}' ifname wlan0 >/dev/null 2>&1; rc=$?; sleep 3; " \
                  "echo \"IP $(ip -4 -o addr show wlan0 | awk '{print $4}')\"; exit $rc"
            self.run_cmd("Wi-Fi: " + ssid, cmd)
            return None
        return ("wifi", ssid)

    # --- выполнение ---
    def execute(self):
        label, _, cmd = MENU_ITEMS[self.item]
        self.run_cmd(label, cmd)

    def run_cmd(self, label, cmd):
        log(f"menu action: {label}")
        self.title = label
        self.lines, self.rc, self.screen, self._buf = [], None, "run", b""
        self.proc = subprocess.Popen(["sh", "-c", cmd], stdin=subprocess.DEVNULL,
                                     stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=ENV)
        os.set_blocking(self.proc.stdout.fileno(), False)
        self.draw()

    def pump(self):
        """Читать вывод выполняемой команды; по завершении показать результат."""
        try:
            data = os.read(self.proc.stdout.fileno(), 65536)
        except BlockingIOError:
            data = None
        if data:
            self._buf += data
            *done, self._buf = self._buf.split(b"\n")
            self.lines += [ln.decode(errors="replace") for ln in done]
            self.draw()
        if data == b"":
            if self._buf:
                self.lines.append(self._buf.decode(errors="replace"))
                self._buf = b""
            self.rc = self.proc.wait()
            self.proc.stdout.close()
            self.proc = None
            self.screen = "result"
            log(f"menu action done rc={self.rc}")
            self.draw()

    def fd(self):
        return self.proc.stdout.fileno() if self.proc else None


class Touch:
    """Касания тачскрина (MT protocol B): (x, y) начала касания — при отпускании пальца.

    Координаты хранятся по слотам: ядро не присылает X/Y, если в этом слоте они не
    изменились, а разные касания приходят в разные слоты (Novatek на sdm660 —
    часто в слот 1). Касанием считается первый палец (основной слот).
    """

    def __init__(self):
        self.slot = 0
        self.pos = {}            # слот -> [x, y]
        self.primary = None      # слот первого пальца
        self.start = None
        self.need_start = False
        self.lifted = False
        self.down = False        # для устройств без ABS_MT_TRACKING_ID
        self.mt_ids = False

    def xy(self, slot):
        return self.pos.setdefault(slot, [0, 0])

    def event(self, etype, code, value):
        if etype == EV_ABS:
            if code == ABS_MT_SLOT:
                self.slot = value
            elif code == ABS_MT_POSITION_X:
                self.xy(self.slot)[0] = value
            elif code == ABS_MT_POSITION_Y:
                self.xy(self.slot)[1] = value
            elif code == ABS_MT_TRACKING_ID:
                self.mt_ids = True
                if value >= 0 and self.primary is None:
                    self.primary, self.need_start = self.slot, True
                elif value < 0 and self.slot == self.primary:
                    self.lifted = True
        elif etype == EV_KEY and code == BTN_TOUCH and not self.mt_ids:
            if value and not self.down:
                self.primary, self.need_start = self.slot, True
            elif not value and self.down:
                self.lifted = True
            self.down = bool(value)
        elif etype == EV_SYN and code == 0:
            if self.need_start and self.primary is not None:
                self.need_start = False
                self.start = tuple(self.xy(self.primary))
            if self.lifted:
                self.lifted = False
                end = tuple(self.xy(self.primary)) if self.primary is not None else None
                start, self.start, self.primary = self.start, None, None
                if start and end and abs(end[0] - start[0]) + abs(end[1] - start[1]) <= TAP_MAX_MOVE:
                    return start
        return None


class Keys:
    def __init__(self):
        self.mode = "status"
        self.top = Top()
        self.console = Console()
        self.menu = Menu()
        self.wifi = WifiJoin()
        conf = read_conf()
        self.lock_enabled = conf.get("LOCK", "1") != "0"
        self.locker = Lock(conf.get("LOCK_USER") or main_user())
        self.blank_at = None
        self.forced_blank = False    # экран погашен нами (TIOCL_BLANKSCREEN)
        self.was_blank = False       # для перезапуска клавиатуры после включения экрана
        self.down = set()
        self.pending = None      # (key, t) — нажата, ещё не ясно: щелчок/удержание/комбо
        self.tap_wait = None     # (key, t отпускания) — ждём второй щелчок
        self.held = None
        self.next_repeat = 0.0
        self.lock = False        # после комбо/двойного — игнор до отпускания всех кнопок
        self.last_input = time.monotonic()

    # --- режимы ---
    def set_mode(self, mode):
        if mode == self.mode:
            return
        old = self.mode
        if old == "top":
            self.top.stop()
        elif old == "console":
            self.console.stop()
        elif old == "menu":
            self.menu.stop()
        elif old == "wifi":
            self.wifi.stop()
        elif old == "lock":
            self.locker.stop()
        self.mode = mode
        if mode == "top":
            self.top.start()             # сам переключает на tty2 и поворачивает консоль
        elif mode == "console":
            self.console.start()
        elif mode == "menu":
            self.menu.start()
        elif mode == "wifi":
            self.wifi.start()
        elif mode == "lock":
            self.locker.start()
        else:
            chvt(STATUS_VT)
        log(f"mode {old} -> {mode}")

    def do_lock(self, blank=False):
        if not self.lock_enabled or self.mode == "lock":
            return
        if self.mode == "menu" and self.menu.busy():
            return                       # дождаться окончания действия меню
        self.pending = self.held = self.tap_wait = None
        self.set_mode("lock")
        if blank:
            # buffyboard при запуске включает экран — гасим после её старта
            self.blank_at = time.monotonic() + 1.5

    def has_double(self, key):
        """Есть ли у кнопки в текущем режиме значение «двойное нажатие»."""
        if self.mode == "lock":
            return False                 # в блокировке — только яркость
        if self.mode in ("menu", "wifi"):
            return key == UP
        if self.mode == "console":
            return key == DOWN
        return True

    def combo(self):
        if self.mode == "lock" or (self.mode == "menu" and self.menu.busy()):
            return
        self.set_mode("top" if self.mode == "status" else "status")

    def double(self, key):
        if self.mode == "lock":
            return
        if self.mode == "menu" and self.menu.busy():
            return                   # не уходить, пока выполняется действие
        if key == UP:
            self.set_mode("status" if self.mode in ("menu", "wifi") else "menu")
        elif self.mode == "top":
            self.top.toggle_keyboard()   # в htop VOL- дважды — экранная клавиатура
        else:
            self.set_mode("status" if self.mode == "console" else "console")

    def action(self, key):
        d = +1 if key == UP else -1
        if self.mode == "top":
            self.top.send(ARROW[key] * SCROLL_LINES)
        elif self.mode == "menu":
            self.menu.key(-d)        # VOL+ — вверх по списку
        else:
            bright_step(d)

    def repeat_interval(self):
        return {"top": REPEAT_SCROLL, "menu": REPEAT_MENU}.get(self.mode, REPEAT_BRIGHT)

    def flush_tap(self):
        if self.tap_wait is not None:
            key, _ = self.tap_wait
            self.tap_wait = None
            self.action(key)

    # --- события кнопок ---
    def wake(self):
        """Любое нажатие или касание после нашего гашения — включить экран."""
        if self.forced_blank:
            self.forced_blank = False
            self.blank_at = None
            screen_unblank()
            return True
        return False

    def on_key(self, code, value, now):
        if code == KEY_POWER:
            if value == 1:
                if self.wake():          # погашен нами -> включить
                    return
                if self.mode == "lock":  # экран блокировки включён -> погасить
                    self.blank_at = time.monotonic()
                else:                    # коротко: погасить экран и заблокировать
                    self.do_lock(blank=True)
            return
        if value == 1 and self.wake():
            return                       # нажатие только будит экран
        if code not in (UP, DOWN):
            return
        self.last_input = now
        if value == 1:
            self.down.add(code)
            if self.lock:
                return
            if len(self.down) == 2:
                self.pending = self.held = self.tap_wait = None
                self.lock = True
                self.combo()
                return
            if (self.tap_wait and self.tap_wait[0] == code
                    and now - self.tap_wait[1] <= DOUBLE_WINDOW):
                self.tap_wait = None
                self.lock = True
                self.double(code)
                return
            self.flush_tap()
            self.pending = (code, now)
        elif value == 0:
            self.down.discard(code)
            if self.pending and self.pending[0] == code:
                self.pending = None
                if self.has_double(code):
                    self.tap_wait = (code, now)
                else:
                    self.action(code)
            if self.held == code:
                self.held = None
            if not self.down:
                self.lock = False

    def on_touch(self, x, y, now):
        if self.wake():
            return
        if self.mode == "lock":
            return                       # касания — только экранной клавиатуре
        if self.mode == "top":
            # строка F1..F10 — последняя строка htop (с клавиатурой — прямо над ней)
            self.last_input = now
            self.top.tap(x, y)
            return
        if self.mode != "menu" or self.menu.busy():
            return
        self.last_input = now
        r = self.menu.touch(x, y)
        if r == "exit":
            self.set_mode("status")
        elif isinstance(r, tuple) and r[0] == "wifi":
            self.wifi.ssid = r[1]
            self.set_mode("wifi")

    def wifi_done(self, rc):
        """Помощник ввода пароля завершился: показать итог в меню."""
        ssid, lines = self.wifi.ssid, self.wifi.result()
        log(f"wifi join done rc={rc}")
        self.set_mode("menu")
        self.menu.show_result("Wi-Fi: " + ssid, lines, rc)

    def pending_limit(self, key):
        return HOLD_TIME if self.has_double(key) else COMBO_WINDOW

    def tick(self, now):
        if self.pending:
            key, t0 = self.pending
            if now - t0 >= self.pending_limit(key):
                self.pending = None
                self.action(key)
                self.held = key
                self.next_repeat = t0 + REPEAT_DELAY
        if self.tap_wait is not None and now - self.tap_wait[1] > DOUBLE_WINDOW:
            self.flush_tap()
        if self.held and self.held in self.down and not self.lock and now >= self.next_repeat:
            self.action(self.held)
            self.next_repeat = now + self.repeat_interval()
        if self.blank_at is not None and now >= self.blank_at:
            self.blank_at = None
            self.forced_blank = True
            screen_blank()
        blank = screen_blanked()
        if self.forced_blank and not blank:
            self.forced_blank = False    # экран включил кто-то другой
        if self.mode == "lock":
            self.locker.tick()
            if not self.locker.keyboard_alive():
                self.locker.restart_keyboard()
            elif self.was_blank and not blank:
                # после включения экрана ядро перерисовывает консоль — клавиатуру заново
                self.locker.restart_keyboard(kill=True)
            self.was_blank = blank
            return
        self.was_blank = blank
        if self.lock_enabled and blank:
            log("screen blanked -> lock")
            self.do_lock()
            if self.mode == "lock":
                return
        if self.mode == "top" and now - self.last_input >= IDLE_TOP:
            log("htop idle -> status")
            self.set_mode("status")
        if self.mode == "console":
            idle = min(time.time() - self.console.last_activity(), now - self.last_input)
            if idle >= IDLE_CONSOLE:
                log("console idle -> logout, status")
                self.set_mode("status")
        if self.mode == "wifi":
            idle = min(time.time() - self.wifi.last_activity(), now - self.last_input)
            if idle >= IDLE_WIFI:
                log("wifi join idle -> status")
                self.set_mode("status")
        if self.mode == "menu":
            if self.menu.busy():
                self.last_input = now    # пока выполняется действие, не выходим
            elif now - self.last_input >= IDLE_MENU:
                log("menu idle -> status")
                self.set_mode("status")

    def timeout(self, now):
        t = []
        if self.pending:
            key, t0 = self.pending
            t.append(t0 + self.pending_limit(key) - now)
        if self.tap_wait is not None:
            t.append(self.tap_wait[1] + DOUBLE_WINDOW - now + 0.001)
        if self.held and self.held in self.down:
            t.append(self.next_repeat - now)
        if self.mode == "top":
            t.append(self.last_input + IDLE_TOP - now)
        if self.mode == "console":
            t.append(5.0)            # простой консоли и жив ли buffyboard
        if self.mode in ("menu", "wifi"):
            t.append(1.0)            # простой меню, завершение ввода пароля
        t.append(2.0)                # гашение экрана -> блокировка; часы на экране блокировки
        if self.blank_at is not None:
            t.append(self.blank_at - now)
        return max(0.0, min(t)) if t else None


def read_events(fd):
    data = os.read(fd, EV_SIZE * 64)
    for i in range(0, len(data) - EV_SIZE + 1, EV_SIZE):
        yield struct.unpack(EV_FMT, data[i:i + EV_SIZE])[2:]


def main():
    keys_devs = key_devices()
    power_devs = [d for d in power_devices() if d not in keys_devs]
    while not keys_devs:
        time.sleep(2)
        keys_devs = key_devices()
    touch_dev = touch_device()
    log(f"input: keys {' '.join(keys_devs)}, touch {touch_dev}; screen {SCREEN_W}x{SCREEN_H}; "
        f"backlight {BL}; init {'systemd' if SYSTEMD else 'openrc'}")
    k = Keys()
    touch = Touch()

    def on_term(*_):
        if k.mode == "lock":
            vt_lockswitch(False)         # остаёмся на экране блокировки, табло не показываем
        else:
            k.set_mode("status")
        sys.exit(0)
    signal.signal(signal.SIGTERM, on_term)
    sig_r, sig_w = os.pipe()
    os.set_blocking(sig_r, False)
    os.set_blocking(sig_w, False)
    signal.set_wakeup_fd(sig_w)
    SIG_LOCK, SIG_UNLOCK = signal.SIGRTMIN + 1, signal.SIGRTMIN + 2
    for s in (signal.SIGUSR1, signal.SIGUSR2, signal.SIGHUP, SIG_LOCK, SIG_UNLOCK):
        signal.signal(s, lambda *a: None)
    Console().getty_stop()                    # на случай перезапуска из режима консоли
    if k.lock_enabled:
        log(f"screen lock: on, user {k.locker.user}")
        k.do_lock()                           # при запуске (загрузке) — сразу блокировка

    evfds = [os.open(d, os.O_RDONLY) for d in keys_devs + power_devs]
    tfd = os.open(touch_dev, os.O_RDONLY) if touch_dev else None
    if tfd is not None:
        # Ядро не присылает координату, если она не изменилась. После перезапуска
        # службы касание в ту же точку пришло бы без X/Y — берём текущие значения.
        # Для MT-осей значения хранятся по слотам: EVIOCGMTSLOTS — все слоты.
        nslots = 16
        size = 4 * (1 + nslots)
        req = (2 << 30) | (size << 16) | (ord("E") << 8) | 0x0a     # EVIOCGMTSLOTS(size)
        vals = []
        for code in (ABS_MT_POSITION_X, ABS_MT_POSITION_Y):
            try:
                buf = fcntl.ioctl(tfd, req, struct.pack("I", code) + b"\0" * (size - 4))
                vals.append(struct.unpack(f"I{nslots}i", buf)[1:])
            except OSError:
                vals.append((0,) * nslots)
        try:   # текущий слот: EVIOCGABS(ABS_MT_SLOT)
            slot = struct.unpack("6i", fcntl.ioctl(tfd, 0x80184540 + 0x2f, b"\0" * 24))[0]
        except OSError:
            slot = 0
        slot = slot if 0 <= slot < nslots else 0
        touch.slot = slot
        for n in range(nslots):
            touch.pos[n] = [vals[0][n], vals[1][n]]
        log(f"touch: current slot {slot}, slot positions taken from kernel")
    while True:
        now = time.monotonic()
        fds = evfds + [sig_r]
        if tfd is not None:
            fds.append(tfd)
        if k.top.running():
            fds.append(k.top.master)
            fds.append(k.top.out)        # ввод с клавиатуры для htop
        if k.menu.fd() is not None:
            fds.append(k.menu.fd())
        if k.mode == "lock" and k.locker.out is not None:
            fds.append(k.locker.out)
        r, _, _ = select.select(fds, [], [], k.timeout(now))
        now = time.monotonic()
        if sig_r in r:
            for s in os.read(sig_r, 64):
                k.last_input = now
                if s == SIG_LOCK:
                    k.do_lock(blank=True)
                elif s == SIG_UNLOCK and k.mode == "lock":
                    log("unlocked remotely (nura-ctl unlock)")
                    k.set_mode("status")
                elif k.mode == "lock":
                    log(f"signal {s} ignored: locked")
                elif s == signal.SIGUSR1:
                    k.combo()
                elif s == signal.SIGUSR2:
                    k.double(DOWN)
                elif s == signal.SIGHUP:
                    k.double(UP)
        for evfd in evfds:
            if evfd not in r:
                continue
            for etype, code, value in read_events(evfd):
                if etype == EV_KEY:
                    k.on_key(code, value, now)
        if tfd is not None and tfd in r:
            for etype, code, value in read_events(tfd):
                pos = touch.event(etype, code, value)
                if pos:
                    k.on_touch(pos[0], pos[1], now)
        if k.mode == "lock" and k.locker.out is not None and k.locker.out in r:
            try:
                data = os.read(k.locker.out, 4096)
            except OSError:
                data = b""
            if data and k.locker.feed(data):
                k.set_mode("status")
        if k.top.running() and k.top.out in r:
            k.top.forward_input()
            k.last_input = now           # набор на клавиатуре — не простой
        if k.top.running() and k.top.master in r:
            if not k.top.pump():
                log("htop exited")
                k.set_mode("status")
        if k.top.running():
            k.top.sync_size()
        if k.menu.fd() is not None and k.menu.fd() in r:
            k.menu.pump()
        if k.mode == "wifi":
            rc = k.wifi.finished()
            if rc is not None:
                k.wifi_done(rc)
            elif k.wifi.kbd and k.wifi.kbd.poll() is not None:
                log("buffyboard exited -> status")
                k.set_mode("status")
        if k.mode == "console" and k.console.kbd and k.console.kbd.poll() is not None:
            log("buffyboard exited -> status")
            k.set_mode("status")
        k.tick(now)


if __name__ == "__main__":
    main()
