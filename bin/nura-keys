"""nura-keys: кнопки громкости и тачскрин OnePlus One и Nexus 5 (Nura, без Phosh).

Режимы:
    табло   (tty1, nura-status)       VOL+/VOL-  яркость
    htop    (tty2)                     VOL+/VOL-  прокрутка; VOL- дважды — клавиатура
    консоль (tty3, login + buffyboard) VOL+/VOL-  яркость
    меню    (tty4)                     VOL+/VOL-  выбор пункта, касание — выполнить
    Wi-Fi   (tty5, пароль + buffyboard) ввод пароля новой сети (из меню)

Переключение:
    VOL+ и VOL- вместе   табло <-> htop       (из консоли/меню — на табло)
    VOL- дважды          -> консоль           (из консоли — на табло)
    VOL+ дважды          -> меню действий     (из меню — на табло)
    удержание VOL+/VOL-  непрерывное действие

Удалённо: sudo nura-ctl top | console | menu   (сигналы USR1 / USR2 / HUP процессу nura-keys)

Железо определяется само: экран (fb0), подсветка, кнопки громкости (любые устройства
с KEY_VOLUMEUP/DOWN — на sdm660 VOL- на pm8941_resin), тачскрин (устройство с
ABS_MT_POSITION_X). Система инициализации — systemd или OpenRC.

htop, консоль и меню работают только в своём режиме. Выход из консоли
завершает сессию входа. Меню закрывается через IDLE_MENU секунд без
действий — раньше, чем гаснет экран, чтобы касание тёмного экрана
ничего не запустило.
"""
import errno
import fcntl
import glob
import json
import os
import pty
import select
import signal
import struct
import subprocess
import sys
import termios
import time
import tty

BL = (sorted(glob.glob("/sys/class/backlight/*")) or ["/sys/class/backlight/lcd-backlight"])[0]
LEVELS_PCT = [1, 2, 3, 5, 8, 12, 18, 26, 36, 48, 62, 80, 100]   # глаз — логарифмический
SYSTEMD = os.path.isdir("/run/systemd/system")
KEY_VOLUMEDOWN, KEY_VOLUMEUP, BTN_TOUCH = 114, 115, 330
UP, DOWN = KEY_VOLUMEUP, KEY_VOLUMEDOWN
EV_SYN, EV_KEY, EV_ABS = 0, 1, 3
ABS_MT_POSITION_X, ABS_MT_POSITION_Y = 0x35, 0x36
ABS_MT_SLOT, ABS_MT_TRACKING_ID = 0x2f, 0x39
EV_FMT = "llHHi"
EV_SIZE = struct.calcsize(EV_FMT)

COMBO_WINDOW = 0.15    # с: кнопка без «двойного» значения — ожидание второй кнопки (комбо)
HOLD_TIME = 0.30       # с: кнопка с «двойным» значением — дольше этого считается удержанием
DOUBLE_WINDOW = 0.30   # с: пауза между щелчками двойного нажатия
REPEAT_DELAY = 0.45    # с: от нажатия до начала автоповтора
REPEAT_BRIGHT = 0.25   # с: шаг автоповтора яркости
REPEAT_SCROLL = 0.07   # с: шаг автоповтора прокрутки htop
REPEAT_MENU = 0.30     # с: шаг автоповтора в меню
SCROLL_LINES = 3
IDLE_TOP = 300         # с: htop без нажатий -> табло
IDLE_CONSOLE = 600     # с: консоль без ввода -> logout и табло
IDLE_MENU = 45         # с: меню без действий -> табло (экран гаснет через 60 с)
IDLE_WIFI = 300        # с: ввод пароля Wi-Fi без действий -> табло

# --- блокировка экрана паролем пользователя ---
# Экран блокировки — на tty5 (общий с вводом пароля Wi-Fi: эти режимы не бывают
# одновременно). buffyboard уменьшает высоту только консолей 1..6; на tty7 текст
# занимал весь экран, и перерисовка затирала клавиатуру.
LOCK_VT = 5
LOCK_FAILS_MAX = 5     # неверных паролей подряд -> пауза
LOCK_LOCKOUT = 300     # с: пауза после LOCK_FAILS_MAX ошибок
LOCK_DELAY = 2.0       # с: задержка после каждой ошибки
CONF_FILE = "/etc/nura-server-shell.conf"
STATE_FILE = "/run/nura-status.state"          # ok | warn | bad — пишет nura-status
FAILS_FILE = "/var/lib/nura-server-shell/lock-fails"
FB_BLANK = "/sys/class/graphics/fb0/blank"
KEY_POWER = 116
VT_LOCKSWITCH, VT_UNLOCKSWITCH = 0x560B, 0x560C
TIOCLINUX, TIOCL_UNBLANKSCREEN, TIOCL_BLANKSCREEN = 0x541C, 4, 14
TAP_MAX_MOVE = 120     # px: больше — это свайп, а не касание

STATUS_VT, TOP_VT, CONSOLE_VT, MENU_VT, WIFI_VT = 1, 2, 3, 4, 5
WIFI_JOIN = "/usr/local/bin/nura-wifi-join"
WIFI_LOG = "/run/nura-wifi-join.log"
WIFI_MAX = 6           # сколько сетей показывать (по силе сигнала)
FONT = "ter-v32b"      # 16x32 -> 67x60; с удвоением (-d) 32x64 -> 33x30
TOP_FONT_PORTRAIT = "ter-v24b"   # 12x24 -> 90x80: строка F1..F10 htop (81 колонка) помещается
def _screen_size():
    """Видимый размер экрана: /sys/class/graphics/fb0/modes («U:1080x2340p-0»)."""
    try:
        with open("/sys/class/graphics/fb0/modes") as f:
            w, h = f.readline().split(":")[1].split("p")[0].split("x")
            return int(w), int(h)
    except (OSError, ValueError, IndexError):
        return 1080, 1920


SCREEN_W, SCREEN_H = _screen_size()  # портрет: 1080x1920 (msm8974), 1080x2340 (sdm660)
ROT_FILE = "/var/lib/nura-server-shell/rotate"   # 0 — портрет, 1 — альбом (htop и консоль)
# F1..F10 для TERM=linux (htop запущен с ним)
FKEYS = [b"\x1b[[A", b"\x1b[[B", b"\x1b[[C", b"\x1b[[D", b"\x1b[[E",
         b"\x1b[17~", b"\x1b[18~", b"\x1b[19~", b"\x1b[20~", b"\x1b[21~"]
# без --readonly: с клавиатурой работают kill (k/F9), nice (F7/F8), фильтр и т. д.
HTOP_CMD = ["htop", "--no-mouse", "-d", "20", "-s", "PERCENT_CPU"]
ARROW = {UP: b"\x1b[A", DOWN: b"\x1b[B"}
ENV = {"PATH": "/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin", "LANG": "C.UTF-8", "HOME": "/root"}

# --- действия меню: (название, вопрос подтверждения, команда sh) ---
